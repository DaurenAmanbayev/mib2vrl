# vector.yaml — generated by mib2vrl {{ VERSION }}
# Date: {{ EXPORT_HELPER.getDate() }}
#
# Complete Vector.dev pipeline configuration for SNMP trap ingestion.
# Customize the sinks section for your environment.

data_dir: /var/lib/vector

api:
  enabled: true
  address: "0.0.0.0:8686"

sources:
  snmp_udp:
    type: socket
    mode: udp
    address: "0.0.0.0:514"
    decoding:
      codec: bytes

enrichment_tables:
  snmp_severity:
    type: file
    file:
      path: "/etc/vector/enrichment_severity.csv"
      encoding:
        type: csv
    schema:
      severity_code: "integer"
      severity_name: "bytes"
      severity_color: "bytes"

transforms:
  snmp_parse:
    type: remap
    inputs:
      - snmp_udp
    source: |
      # Parse raw SNMP trap bytes into structured fields
      # Expects pre-parsed SNMP data from an upstream trap daemon
      . = parse_json!(string!(.message))

      # Normalize numeric OIDs to text format used in mib_remap comparisons
      oid_map = {
        "1.3.6.1.6.3.1.1.5.1": "snmpTraps 1",
        "1.3.6.1.6.3.1.1.5.2": "snmpTraps 2",
        "1.3.6.1.6.3.1.1.5.3": "snmpTraps 3",
        "1.3.6.1.6.3.1.1.5.4": "snmpTraps 4",
        "1.3.6.1.6.3.1.1.5.5": "snmpTraps 5",
        "1.3.6.1.6.3.1.1.5.6": "snmpTraps 6",
{%- for trap in TRAP_LIST if trap.snmp_version == 1 and trap.vendor_enterprise_oid %}
        "{{ trap.get_snmpv1_oid() }}": "{{ trap.get_snmpv1_oid() }}",
{%- endfor %}
      }
      _mapped = get!(oid_map, [.snmp_trap_oid])
      if _mapped != null { .snmp_trap_oid = _mapped }

  snmp_mib_remap:
    type: remap
    inputs:
      - snmp_parse
    source: |
{% set indent = "      " %}
{% for trap in TRAP_LIST %}
{% if trap.snmp_version == 2 %}
{{ indent }}if .snmp_trap_oid == "{{ trap.oid }}" {
{% elif trap.vendor_enterprise_oid %}
{{ indent }}if .snmp_trap_oid == "{{ trap.get_snmpv1_oid() }}" {
{% elif trap.get_snmpv1_oid() %}
{{ indent }}if .snmp_trap_oid == "snmpTraps {{ trap.trap_number + 1 }}" {
{% else %}
{{ indent }}if .snmp_enterprise == "{{ trap.enterprise }}" && .snmp_specific_trap == {{ trap.trap_number }} {
{% endif %}
{{ indent }}    .agent       = .host
{{ indent }}    .alert_group = "{{ trap.alert_group if trap.alert_group else trap.module }}"
{{ indent }}    .alert_key   = "{{ trap.name }}"
{{ indent }}    .severity    = {{ trap.get_rules_severity() }}
{{ indent }}    .summary     = "{{ trap.name }}"
{% for vb in trap.varbinds %}
{{ indent }}    .{{ vb.name }} = .varbinds[{{ vb.index }}]
{% endfor %}
{{ indent }}}
{% if not loop.last %}

{% endif %}
{% endfor %}
{{ indent }}# Return the modified event
{{ indent }}.

  snmp_enrich:
    type: remap
    inputs:
      - snmp_mib_remap
    source: |
      sev, err = get_enrichment_table_record("snmp_severity", {
        "severity_code": int(.severity) ?? 3
      })
      if err == null {
        .severity_name = sev.severity_name
      }

sinks:
  # TODO: configure your output sink
  stdout_debug:
    type: console
    inputs:
      - snmp_enrich
    encoding:
      codec: json
