## VRL remap transform — generated by mib2vrl {{ VERSION }}
## Date: {{ EXPORT_HELPER.getDate() }}
##
## Field mapping:
##   @Agent      → .agent
##   @AlertGroup → .alert_group
##   @AlertKey   → .alert_key
##   @Summary    → .summary
##   @Severity   → .severity (integer 1–5)
##
## Severity levels (Netcool convention):
##   1 = Critical, 2 = Major, 3 = Warning, 4 = Minor, 5 = Info
##
## Usage in vector.yaml:
##   transforms:
##     mib_remap:
##       type: remap
##       inputs: [snmp_source]
##       source: |
##         <paste this file content>

{% for trap in TRAP_LIST %}
{% if trap.snmp_version == 2 %}
if .snmp_trap_oid == "{{ trap.oid }}" {
{% elif trap.get_snmpv1_oid() %}
if .snmp_trap_oid == "{{ trap.get_snmpv1_oid() }}" {
{% else %}
if .snmp_enterprise == "{{ trap.enterprise }}" && .snmp_specific_trap == {{ trap.trap_number }} {
{% endif %}
    .agent       = .host
    .alert_group = "{{ trap.alert_group if trap.alert_group else trap.module }}"
    .alert_key   = "{{ trap.name }}"
    .severity    = {{ trap.get_rules_severity() }}
    .summary     = "{{ trap.name }}"
{% if trap.description %}
    # {{ EXPORT_HELPER.sanitize_description(trap.description) }}
{% endif %}

{% if trap.varbinds %}
    # Varbind assignments
{% for vb in trap.varbinds %}
    .{{ vb.name }} = .varbinds[{{ vb.index }}]
{% if RULES_VARBIND_OIDS and vb.oid %}
    # OID: {{ vb.oid }}
{% endif %}
{% endfor %}
{% endif %}
}

{% endfor %}

# Return the modified event
.
