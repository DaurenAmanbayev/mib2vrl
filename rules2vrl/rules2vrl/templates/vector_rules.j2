# vector.yaml — generated by rules2vrl {{ version }}
# Source: {{ source_file }}
# Date: {{ date }}
#
# Vector.dev pipeline configuration for SNMP trap processing
# with Netcool rules translation.

data_dir: /var/lib/vector

api:
  enabled: true
  address: "0.0.0.0:8686"

sources:
  snmp_udp:
    type: socket
    mode: udp
    address: "0.0.0.0:514"
    decoding:
      codec: bytes

{% if enrichment_tables %}
enrichment_tables:
{% for table_name, csv_path in enrichment_tables %}
  {{ table_name }}:
    type: file
    file:
      path: "{{ csv_path }}"
      encoding:
        type: csv
    schema:
      key: "bytes"
      value: "bytes"
{% endfor %}

{% endif %}
transforms:
  snmp_parse:
    type: remap
    inputs:
      - snmp_udp
    source: |
      # Parse raw SNMP trap bytes into structured fields
      . = parse_json!(string!(.message))

  rules_remap:
    type: remap
    inputs:
      - snmp_parse
    source: |
{% for line in vrl_lines %}
      {{ line }}
{% endfor %}

sinks:
  # TODO: configure your output sink
  stdout_debug:
    type: console
    inputs:
      - rules_remap
    encoding:
      codec: json
